<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ekkolabs.ableton-organizer-cert</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/src/ableton-organizer/launchd/renew-cert.sh</string>
    <string>your-machine.your-tailnet.ts.net</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>86400</integer>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/ableton-organizer-cert.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/ableton-organizer-cert.log</string>
</dict>
</plist>
